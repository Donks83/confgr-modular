node_modules/
dist/
dist-electron/
.vite/
*.log
.DS_Store
Thumbs.db
test-assets-broken/

# CAD conversion: the venv is 100MB+ of OpenCASCADE and reinstalls in one
# command; the converted GLBs regenerate from the STEP files, which are
# Kesseboehmer's and live outside the repo. The .confgr.json sidecars ARE
# committed - those hold decisions, not derived geometry.
tools/.venv-step/
youk/*.glb

# tools/probe-bay.ps1 copies the converted YouK components into test-assets so
# the app can load them. Those are the same derived supplier geometry as
# youk/*.glb - the synthetic test-assets/*.glb ARE committed, these are not.
# Every YouK id starts with a 6-digit Kesseboehmer article number.
test-assets/[0-9][0-9][0-9][0-9][0-9][0-9]-*.glb
# The timber boards are ours rather than Kesseboehmer's, so they have no article
# number and the rule above misses them. Same reasoning though, and more so:
# tools/make-timber.py IS committed, so the geometry regenerates from the repo
# itself in one command.
test-assets/pws-*.glb
youk/bay-run.txt
youk/declare-log.txt
youk/probe-out.txt

# Invented prices, generated on demand by tools/make-example-prices.mjs for
# demos. Deliberately NOT committed: fictional money in a repo is
# indistinguishable from the real thing once nobody remembers which is which,
# and regenerating it takes a second. youk/catalogue.json - the real one, with
# its prices still null - IS committed.
youk/catalogue.example.json
youk/run.png

# Scratch file for `git commit -F`. Nested PowerShell quoting eats backticks,
# `<` and `$env:`, so commit messages are written to a file rather than passed
# on a command line. The file is a means, not a record - git has the message.
.commitmsg

# The whole-window capture (-WholeWindow) returns 0 bytes on this machine when
# the window is not composited. The mount scenario proves itself from the scene
# readback instead, so its capture is not evidence and is not committed.
youk/mount.png
youk/palette.png
youk/stagger.png
youk/shared.png
youk/hooks.png
youk/wallfixed.png
youk/cabinets.png
youk/timber.png
# -Steps writes here rather than over a scenario's picture. An ad-hoc probe is
# a question being asked, not an answer worth keeping.
youk/steps.png
youk/carcase.png 
youk/office.png 
youk/condition.png 
youk/officetilt.png 
youk/officeclamp.png
