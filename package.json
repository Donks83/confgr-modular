{
  "name": "confgr-modular",
  "productName": "Confgr Modular",
  "version": "0.1.0",
  "description": "Modular 3D product configurator authoring tool",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5174 && electron .\"",
    "dist": "vite build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:assets": "node tests/make-test-glb.mjs test-assets",
    "test:broken": "node tests/make-broken-glb.mjs test-assets-broken",
    "youk:convert": "tools\\.venv-step\\Scripts\\python tools/step-to-glb.py \"C:/Claude/YouK models\" -o youk --max-tris 40000 --report youk/convert-report.json",
    "youk:timber": "tools\\.venv-step\\Scripts\\python tools/make-timber.py youk",
    "youk:snap": "tools\\.venv-step\\Scripts\\python tools/add-snaps.py youk --spec youk/snap-spec.json",
    "youk:sheet": "tools\\.venv-step\\Scripts\\python tools/contact-sheet.py youk -o youk/contact-sheet.png",
    "youk:bay": "powershell -ExecutionPolicy Bypass -File tools/probe-bay.ps1",
    "youk:catalogue": "node tools/make-catalogue.mjs youk",
    "youk:describe": "node tools/describe-glb.mjs youk",
    "youk:export": "node tools/export-glb.mjs youk",
    "youk:prices:example": "node tools/make-example-prices.mjs",
    "measure": "tools\\.venv-step\\Scripts\\python tools/measure-part.py",
    "joint": "tools\\.venv-step\\Scripts\\python tools/check-joint.py",
    "joints": "powershell -ExecutionPolicy Bypass -File tools/check-joints.ps1",
    "inspect": "node tools/inspect-model.mjs",
    "declare": "node tools/declare.mjs",
    "verify": "vitest run",
    "holes": "tools\\\\.venv-step\\\\Scripts\\\\python tools/find-holes.py"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.183.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3",
    "jsdom": "^29.1.1",
    "vite": "^5.4.0",
    "vitest": "^2.1.9",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "uk.confgr.modular",
    "productName": "Confgr Modular",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
